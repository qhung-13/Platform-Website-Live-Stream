# Server
PORT=5000
NODE_ENV=development

# Public browser-facing URLs. In production these must be your real HTTPS
# domains, e.g. https://api.example.com and https://example.com.
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Comma-separated frontend origins allowed to call REST / Socket.IO.
CORS_ORIGINS=http://localhost:5173,http://localhost

# Database
MONGO_URI=mongodb://localhost:27017/omexlive
MONGO_TEST_URI=mongodb://localhost:27017/omexlive_test

# Redis is optional for one local backend instance. Set it for viewer presence,
# moderation and Socket.IO scaling across multiple backend replicas.
REDIS_URL=redis://127.0.0.1:6379

# Live playback / ingest
MEDIA_SERVICE_URL=http://localhost:8080/live
MEDIA_CONTROL_URL=http://localhost:8080
CDN_BASE_URL=
RTMP_SERVER_URL=rtmp://localhost:1935/live

# Auth. Generate long random values; do not commit real secrets.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
MEDIA_SERVICE_SECRET=replace-with-the-same-secret-used-by-media-service
MEDIA_PUBLISH_AUTH_SECRET=replace-with-a-separate-32-character-secret
AGENT_SERVICE_SECRET=
AGENT_SERVICE_URL=http://localhost:8001

# Google OAuth
# Authorized redirect URI (local):
# http://localhost:5000/api/v1/users/auth/google/callback
# Production: ${BACKEND_PUBLIC_URL}/api/v1/users/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo SMTP)
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OBS signed credential lifetime; reset the stream key to revoke immediately.
INGEST_SIGNATURE_TTL_SECONDS=315360000
